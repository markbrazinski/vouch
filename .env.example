# Vouch local configuration. Copy to `.env`, which is gitignored.
#
#   cp .env.example .env
#
# ============================================================================
# AWS CREDENTIALS DO NOT BELONG IN THIS FILE, OR IN ANY REPOSITORY FILE.
# They live in ~/.aws/credentials under the `gatehouse` profile, or come from
# the ambient session / instance role. Never put a real secret in .env.example,
# a fixture, an issue, or a commit.
# ============================================================================
#
# NOTHING HERE IS REQUIRED FOR THE OFFLINE PATH. The decision core, the whole
# test suite and the single-decision example in README.md run with no
# credentials, no network and no .env at all. Set these only for the live AWS
# paths (`make bff`, `make live`, `make reseed`, deploys).
#
# Naming: every variable is read as VOUCH_<NAME> first, falling back to the
# pre-rename GATEHOUSE_<NAME> (src/vouch/config.py:73). The fallback exists
# because the already-deployed runtime was launched with GATEHOUSE_* set; prefer
# VOUCH_* for anything new.
#
# Account-specific values (account id, bucket name, table name, role ARN) come
# from `provisioning.json`, which is gitignored because it is deployment
# targeting information. Set the variables below only to override that manifest.


# ---- identity and region ---------------------------------------------------
# Binding policy (AGENTS.md §13): all Vouch AWS work uses the `gatehouse`
# profile, which must authenticate as IAM user `gatehouse-dev`. Verify before
# any live run:
#   aws sts get-caller-identity --profile gatehouse --region us-east-1
# Anything other than .../user/gatehouse-dev is a hard stop. Never borrow
# another project's profile — it produces misleading capability results.
AWS_PROFILE=gatehouse
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1


# ---- execution mode --------------------------------------------------------
# Which STORES back the run:
#   local      in-memory corpus, no AWS, no credentials  (default, and what
#              the test suite uses)
#   production real DynamoDB + S3
VOUCH_MODE=local

# Which REASONERS decide:
#   local      deterministic scripted reasoners (default) — offline, repeatable
#   bedrock    real Amazon Bedrock model invocations
# Durable stores paired with scripted reasoners are refused outright
# (src/vouch/v2/runtime.py), so these two cannot disagree silently.
VOUCH_V2_MODE=local


# ---- model policy ----------------------------------------------------------
# Baseline is Amazon Nova Pro. Do NOT silently substitute another model — see
# AGENTS.md "Model policy". A model change is a product decision, never a
# workaround for a failure. Per-role overrides exist so evaluations can compare
# actor/verifier pairings; they are not for making a demo pass.
# VOUCH_MODEL_ACTOR=us.amazon.nova-pro-v1:0
# VOUCH_MODEL_VERIFIER=us.amazon.nova-pro-v1:0


# ---- account resources (override provisioning.json only) -------------------
# VOUCH_STATE_TABLE=
# VOUCH_EVIDENCE_BUCKET=
# VOUCH_RUNTIME_ARN=
# VOUCH_RUNTIME_NAME=
# VOUCH_RUNTIME_VERSION=
# VOUCH_RUNTIME_ROLE_ARN=


# ---- Bedrock Guardrails ----------------------------------------------------
# Prompt-attack screening at the evidence boundary. Deliberately a LAYER and
# not the boundary: the red-team suite proves an injected document is inert with
# detection disabled. `bedrock:CreateGuardrail` is denied to gatehouse-dev by
# design, so these reference an already-provisioned guardrail.
# VOUCH_GUARDRAIL_ID=
# VOUCH_GUARDRAIL_VERSION=
#
# Escape hatch for deploying without guardrails. Leave unset: it weakens a
# defense-in-depth layer and should be a deliberate, recorded choice.
# VOUCH_DEPLOY_WITHOUT_GUARDRAILS=


# ---- capability issuance key -----------------------------------------------
# HMAC key binding capability records to the Policy Engine. Unset, it is
# process-random — fine locally, but every restart invalidates outstanding
# capabilities. No KMS key or Secrets Manager secret is provisioned; this is a
# recorded prototype limitation, not a production key-management story.
# VOUCH_ISSUANCE_KEY=


# ---- Textract extraction seam ----------------------------------------------
# Reached only when the deterministic parser cannot represent a document (a
# table PDF whose characters read fine but whose structure is the meaning).
# `textract:AnalyzeDocument` is denied to gatehouse-dev, so this is off by
# default and no live call has been measured. See fixtures/README.md.
# VOUCH_TEXTRACT_ENABLED=
# VOUCH_TEXTRACT_FIXTURES=


# ---- local BFF and browser origin ------------------------------------------
# The browser only ever talks to same-origin /api. In production that is
# API Gateway -> Lambda; locally it is scripts/local_bff.py importing the SAME
# handler. Deploys refuse a wildcard origin.
# VOUCH_BFF_PORT=8787
# VOUCH_ALLOWED_ORIGIN=http://localhost:5173


# ---- operator sign-in (Cognito) --------------------------------------------
# The console's session gate. With these unset, authentication always fails
# closed and nobody can sign in — the UI gate is an affordance; every /api route
# is refused server-side without a valid session cookie.
# Secrets belong in your shell or a secret manager, NOT in a committed file.
# VOUCH_JUDGE_POOL_ID=
# VOUCH_JUDGE_CLIENT_ID=
# VOUCH_JUDGE_CLIENT_SECRET=
# VOUCH_SESSION_SECRET=


# ---- test gating -----------------------------------------------------------
# AWS-dependent tests SKIP unless this is set, which is why a laptop run of the
# full suite reports skips rather than failures. `make live` sets it.
# VOUCH_LIVE_AWS=1
