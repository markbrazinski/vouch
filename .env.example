# Gatehouse local config. Copy to .env (gitignored). Never commit real values.
#
# AWS CREDENTIALS DO NOT BELONG HERE.
# They live in ~/.aws/credentials under the `gatehouse` profile.

AWS_PROFILE=gatehouse
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# local = in-memory store + scripted reasoners; bedrock = real Bedrock models
GATEHOUSE_MODE=local

# Baseline model is Amazon Nova Pro. Do not silently substitute another model —
# see AGENTS.md "Model policy". Per-role overrides exist for eval variants only.
# GATEHOUSE_MODEL_ACTOR=us.amazon.nova-pro-v1:0
# GATEHOUSE_MODEL_VERIFIER=us.amazon.nova-pro-v1:0

# Account-specific resources come from provisioning.json (gitignored).
# Set these only to override the manifest.
# GATEHOUSE_EVIDENCE_BUCKET=
# GATEHOUSE_STATE_TABLE=
