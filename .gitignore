# ---- secrets / credentials -------------------------------------------------
.env
.env.*
*.env
!.env.example
.aws/
aws.json
credentials
*.pem
*.key
!**/public*.key
secrets.*

# ---- python ----------------------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
*.egg-info/
.eggs/
.python-version

# ---- build / dist ----------------------------------------------------------
build/
dist/
*.zip
*.tar.gz
node_modules/
cdk.out/
.cdk.staging/

# ---- coverage / test outputs -----------------------------------------------
.coverage
.coverage.*
coverage.xml
htmlcov/
