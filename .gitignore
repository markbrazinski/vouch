.model-output/
tmp/
.tmp/

# ---- private working directories -------------------------------------------
# Deliberately private. Do NOT globally ignore *.md — see allowlist below.
/docs/
/notes/
/research/
/scratch/
/artifacts/
/recordings/
/private-fixtures/

# ---- AgentCore / AWS local targeting ---------------------------------------
# Account- and environment-specific config must stay local.
.agentcore/
agentcore/.local/
agentcore/.env.local
agentcore/.cli/*
!agentcore/.cli/deployed-state.json
agentcore/.cache/*
agentcore/aws-targets.json
agentcore/cdk/cdk.out/
agentcore/cdk/node_modules/
agentcore.local.json
*.local.json
.bedrock_agentcore.yaml
outputs.json
cdk.context.json

# ---- tracked docs allowlist ------------------------------------------------
# These must always remain in version control.
!README.md
!AGENTS.md
!CLAUDE.md
!LICENSE
!LICENSE.*
!SMOKE_TEST_REPORT.md
!EVAL_PLAN.md
agentcore/*.zip
app/Gatehouse/src/
agentcore/*/staging/
agentcore/Gatehouse/

# ---- provisioning manifest (account/environment targeting, local only) ----
provisioning.json
