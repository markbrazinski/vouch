# ---- private working directories -------------------------------------------
# Deliberately private. Do NOT globally ignore *.md — see allowlist below.
/docs/
# Claude Design export: visual/interactivity reference ONLY, never production
# source. Already covered by /docs/ above; stated explicitly so it stays ignored
# if /docs/ is ever un-ignored.
/docs/design/
/notes/
/research/
/scratch/
/artifacts/
/recordings/
/private-fixtures/

# ---- AgentCore / AWS local targeting ---------------------------------------
# Account- and environment-specific config must stay local.
.agentcore/
agentcore/.local/
agentcore/.env.local
agentcore/.cli/*
!agentcore/.cli/deployed-state.json
agentcore/.cache/*
agentcore/aws-targets.json
agentcore/cdk/cdk.out/
agentcore/cdk/node_modules/
agentcore.local.json
*.local.json
.bedrock_agentcore.yaml
outputs.json
cdk.context.json

# ---- tracked docs allowlist ------------------------------------------------
# These must always remain in version control.
!README.md
!AGENTS.md
!CLAUDE.md
!LICENSE
!LICENSE.*
!EVAL_PLAN.md
agentcore/*.zip
app/Gatehouse/src/
agentcore/*/staging/
agentcore/Gatehouse/

# ---- provisioning manifest (account/environment targeting, local only) ----
provisioning.json
strip_results.json

# ---- local-only docs -------------------------------------------------------
# Records of specific runs / not-yet-frozen specs. Not source.
SMOKE_TEST_REPORT.md
evals/

# Only the normative frontend contracts are tracked. Everything else under
# contracts/ — prior audits, agent arbitration — stays local. Order matters:
# git will not descend into an ignored directory, so the path down to the
# files must be re-included before the files themselves.
contracts/*
!contracts/frontend/
contracts/frontend/*
!contracts/frontend/VOUCH_V2_UI_COMPONENT_DATA_REQUIREMENTS.md
!contracts/frontend/VOUCH_V2_FRONTEND_DATA_CONTRACT.md
!contracts/frontend/VOUCH_V2_BACKEND_CONFORMANCE.md
!contracts/frontend/VOUCH_V2_FE_BE_INTEGRATION_CONTRACT.md

# The canonical supplier/document brief is normative: it constrains what the
# synthetic demo PDFs may contain, so it is tracked like the other contracts.
!contracts/demo/
contracts/demo/*
!contracts/demo/VOUCH_V2_CANONICAL_SUPPLIER_DOCUMENT_BRIEF.md

# ---- local agent / editor tooling state ------------------------------------
.claude/settings.local.json
.claude/projects/
.aider*
.cursorignore

# ---- local eval / smoke run output ------------------------------------------
# Run artifacts are regenerated; they are not source.
*_results.json
*_report.json
eval-out/
graphify-out/

# ---- frontend build output --------------------------------------------------
frontend/dist/
frontend/dist-harness-check/
*.tsbuildinfo

# ---- e2e run artifacts ------------------------------------------------------
# The HARNESSES (e2e/*.mjs) are source and stay tracked. What they PRODUCE —
# screenshots, live qualification reports, baseline manifests — is regenerated
# output describing one run, not source. Same rule as *_report.json above.
frontend/e2e/shots/
frontend/e2e/baseline/
